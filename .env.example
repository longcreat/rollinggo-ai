# ===== 织程 TripWeaver 环境变量 =====
# 复制为 .env 后按需修改；标注 [必填] 的缺失时服务拒绝启动

# 服务端口（Windows 本地开发若遇 EACCES，多为端口被系统保留，可改用 8787 等）
PORT=3001

# PostgreSQL 连接串（09-18 起为唯一运行态数据库；本地开发可指向本机 PG 或 Neon/Supabase）
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/tripweaver
# Compose 内 postgres 服务密码（仅 docker compose 部署使用）
POSTGRES_PASSWORD=

# [必填] Key 加密主钥：32 字节 hex（64 个字符）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# 注册模式：open（开放注册，默认）/ invite（凭邀请码）/ closed（关闭注册）
# 未设置时自动推断：INVITE_CODE 非空 → invite，否则 open（老部署升级后行为不变）
REGISTRATION_MODE=

# 注册邀请码（仅 invite 模式使用；该模式下必填）
INVITE_CODE=

# 邮箱验证码（10-18）：open 模式注册与找回密码需要
# RESEND_API_KEY 到 resend.com 创建；缺失时这两条路径返回 503，其余功能不受影响。
# MAIL_FROM 的域名必须先在 Resend 后台验证（Cloudflare 加 DNS 记录），否则发信会被拒绝。
# 当前线上用子域名 notify.sakiiko.com（mail.sakiiko.com 已被临时邮箱服务占用）。
RESEND_API_KEY=
MAIL_FROM=noreply@notify.sakiiko.com

# GitHub 登录（可选）：到 GitHub Developer settings 注册 OAuth App 后填写；留空 = 不显示 GitHub 登录
# callback 填 <APP_BASE_URL>/api/auth/github/callback；本地开发需另注册一个 App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 站点对外地址（启用 GitHub 登录时必填），例：https://trip.example.com；本地开发：http://localhost:5173
APP_BASE_URL=

# 预构建镜像（可选）：docker compose 默认拉取 ghcr.io/aimer-rhythm/trip-weaver:latest
# 本地构建兜底：TRIPWEAVER_IMAGE='' docker compose up --build -d
TRIPWEAVER_IMAGE=

# ===== 库内景点封面（上游 xhs-travel-pipeline 导出的 webp）与图源索引 =====
# local（默认）：字节落在宿主机 data/（已 gitignore、也不在镜像里），compose 只读挂载 ./data/media；
#   首次部署需先把图片同步到宿主机该路径。
# s3：data/ 整体搬进 S3 兼容桶（Cloudflare R2 / MinIO / AWS S3），图片与 photo-store 索引都走对象存储；
#   endpoint 只到域名层级（R2：https://<account_id>.r2.cloudflarestorage.com），bucket 单独填；
#   region 留空即 auto（R2 要求）；凭据用最小权限 Object Read & Write Token。四项缺一即启动失败。
MEDIA_STORE=local
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_REGION=

# 展示用的 URL 前缀：缺省 /media 即同源；挂 CDN 时填完整前缀
# （R2 自定义域名映射 bucket 根，因此填 https://media.example.com/media）。
# 只改前缀**不需要重导数据库** —— 库里存的是相对 key（payload.coverImage）。
MEDIA_BASE_URL=

# 站点供 Key（普通用户默认使用；留空 = 纯 BYOK 模式）
# 原生 DeepSeek（默认）：
SITE_LLM_BASE_URL=https://api.deepseek.com/v1
SITE_LLM_API_KEY=
SITE_LLM_MODEL=deepseek-chat
# 换成阿里云百炼托管的 DeepSeek（OpenAI 兼容接口）时，改成下面三行：
# {WorkspaceId} 是百炼控制台「业务空间详情」里的 ID；旧域名 dashscope.aliyuncs.com 仍可用但官方建议迁移。
# SITE_LLM_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# SITE_LLM_API_KEY=sk-xxx
# SITE_LLM_MODEL=deepseek-v4.1-flash
# 百炼的模型 ID 不带 deepseek/ 前缀；参数差异（max_tokens、enable_thinking、developer 角色）
# 由 lib/llmCompat.ts 统一处理。Anthropic 兼容端点（/apps/anthropic）本项目的 OpenAI 链路用不到。

# ===== RAG 向量召回（可选；留空即不生成向量，检索退化为纯关键词召回）=====
# 未填时回落到上面的 SITE_LLM_*（OpenAI 兼容端点普遍同址提供 /embeddings）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# 默认 cf/bge-m3
EMBEDDING_MODEL=
# 必须为 1024，与 canonical_places / research_evidence 的 vector(1024) 列对齐；
# 改维度需 DROP COLUMN 重建并重跑 apps/server/scripts/embed-backfill.ts
EMBEDDING_DIMS=1024

# 每用户每日生成次数上限
GEN_DAILY_LIMIT=3

# 每用户每日对话轮数上限（问答式入口；与生成配额相互独立，对话轮次不计入 GEN_DAILY_LIMIT）
CHAT_DAILY_LIMIT=40

# ===== 调研数据源（均可选；都不填 = 纯模型知识调研，生成不受影响）=====

# 站点默认高德开放平台 Web 服务 Key（用户可在设置页保存个人 Key，并优先用于自己的任务）
# 用户未配置或显式清除个人 Key 时回退此值；两者都为空时自动降级。
# 调研候选的结构化底座：地点/评分/人均/营业时间/图片
# 申请：https://console.amap.com/dev/key/app 创建应用 → Key 类型选「Web服务」
# 个人实名认证后基础搜索约 5000 次/月；仅作调研候选来源，行程坐标走高德 GCJ-02 主链（Nominatim 仅兜底）
AMAP_KEY=
# 个人认证、无流量包：基础 LBS 五项共享 150000/月，搜索独立 5000/月。
# 来源 https://lbs.amap.com/upgrade ，核对于 2026-09-29；免费权益有效期以控制台为准。
# 按 31 天折算，不扣当前已用量；全站所有 Key 共用本系统账本。
AMAP_LBS_MONTHLY_BUDGET=150000
AMAP_SEARCH_MONTHLY_BUDGET=5000
# 留空自动计算：LBS 五项各 967/日，POI 161/日；0 禁用对应服务。
# 自定义五项 LBS 之和不得超过 floor(月预算/31)，POI 同理。
AMAP_GEOCODE_DAILY_BUDGET=
AMAP_PLACE_DAILY_BUDGET=
AMAP_WALK_DAILY_BUDGET=
AMAP_CYCLE_DAILY_BUDGET=
AMAP_DRIVE_DAILY_BUDGET=
AMAP_TRANSIT_DAILY_BUDGET=
# 兼容旧部署：若保留此值，仅压低未独立配置服务的默认值；新部署留空。
AMAP_DAILY_BUDGET=

# ===== 行程天气：和风天气 QWeather（10-04 起取代高德）=====
# 和风用**专属 API Host**（控制台-设置，形如 abcxyz.qweatherapi.com）认证：它也是身份认证的一部分，
# 只泄露凭据而不知道 Host 也无法请求。公共域名 api/devapi/geoapi.qweather.com 自 2026 年起逐步停服。
# 免费档每月 5 万次请求（之后 0.0007 元/次）；逐日预报可到 15 天，中国 1km 分辨率。
QWEATHER_API_HOST=

# 凭据二选一，JWT 四项齐全时优先。
#
# 方式 A（推荐）：JWT + Ed25519 私钥现签。token 最长只有 24 小时，静态串过期就 401，必须现签。
#   1. 本地生成密钥对：openssl genpkey -algorithm ED25519 -out ed25519-private.pem
#      openssl pkey -pubout -in ed25519-private.pem > ed25519-public.pem
#   2. 控制台-项目管理-凭据：认证方式选 JSON Web Token，粘贴**公钥**内容
#   3. 下面四项分别填凭据 ID / 开发者 ID / 项目 ID / **私钥**；私钥多行可写成一行，换行处填 \n
QWEATHER_JWT_KEY_ID=
QWEATHER_JWT_DEVELOPER_ID=
QWEATHER_JWT_PROJECT_ID=
QWEATHER_JWT_PRIVATE_KEY=

# 方式 B：API Key（控制台-项目管理-凭据，认证方式选 API KEY），走 X-QW-Api-Key 请求头。
# 填成已签好的 JWT（eyJ 开头三段）时自动改走 Authorization: Bearer —— 仅供临时排查，会过期。
# 注意：和风自 2027-01-01 起限制 API KEY 的每日请求数，长期请改用方式 A。
QWEATHER_KEY=

# 全站和风调用日额度（应用上限，非官方套餐额度）；0 表示关闭调用。
# 每个目的地最多 2 次请求（城市搜索 + 逐日预报），城市缓存 24h、预报缓存 1h。
QWEATHER_DAILY_BUDGET=200

# AI 行程分享图：独立生图凭据，兼容 OpenAI Images API。
# 用户指定第三方接口与模型；不复用站点 LLM Key，留空 Key 时功能不可用。
IMAGE_API_BASE_URL=https://xjbh.lol/v1
IMAGE_MODEL=gpt-image2.5
IMAGE_API_KEY=

# 可选：海报底部品牌带（域名 + 二维码，指向站点首页），默认开启；填 false 关闭
# SHARE_BRAND_ENABLED=true

# 可选：追加中转站（最多 3 个），前一个站点网络错误/超时/5xx/429/鉴权失败时按序降级重试。
# 整条链共享 180 秒总预算；缺 IMAGE_MODEL_n 时沿用 IMAGE_MODEL；缺 IMAGE_API_KEY_n 的站点被跳过。
# IMAGE_API_BASE_URL_2=
# IMAGE_API_KEY_2=
# IMAGE_MODEL_2=

# ===== 前端地图渲染（可选；未配置时自动降级）=====
# 高德 JS API 需要**独立类型**的 Key：在高德控制台创建时平台选「Web端(JS API)」，
# 与上面的 Web 服务（AMAP_KEY）**不通用**。创建时还要填**域名白名单**（本地开发填 localhost），
# 并把配套的**安全密钥**填到下一项（JS API 2.0 起强制，缺失会让所有请求被拒）。
# 两个值都会下发到浏览器 —— 这是 JS API 的设计，不可隐藏，靠域名白名单限权。
# 留空 = 不启用高德渲染，前端静默使用 Leaflet + 高德栅格瓦片（无 POI 文字隐藏）。
# AMAP_JS_KEY=
# AMAP_JS_SECURITY_CODE=

# ===== 地图服务商（高德单轨，2026-11-05 起天地图下线）=====
# 路线规划、地理编码、地点搜索（search_pois）全部走高德，按服务分别记账：
#   · AMAP_PLACE_DAILY_BUDGET   地点搜索（v5/place/text，个人认证 5000/月）
#   · AMAP_*_DAILY_BUDGET        路线/地理编码（LBS 共享 150k/月）
# 缺 AMAP_KEY：坐标走 Nominatim、通勤走启发式、地点搜索空结果 + 模型知识，各自独立降级。

# 站点默认 Web 搜索 API Key（攻略语义层：玩法/避雷/是否需要预约）
# 用户可在设置页保存个人 Key + Base URL，个人配置优先；清除后回退这里，两者都为空时降级。
# 默认 LangSearch：https://langsearch.com/ 免费申请
SEARCH_API_KEY=
# 站点搜索端点（可选，默认 https://api.langsearch.com）；个人新配置的空 URL 也使用此默认值
# 博查（https://open.bochaai.com ，¥0.036/次）同族接口：改此 URL + 换 Key 即可切换，零代码改动
SEARCH_API_BASE_URL=

# ===== 景点封面：免费图库（均可选，填入 apps/server/.env）=====
# 新行程优先读取已授权人工选图，再读新版视觉审核图库；缺图后台补充，不等待补图。
# 缺 Key 时后台跳过该源的新检索；旧行程已保存照片保持可用。
# 申请：https://www.pexels.com/api/ → 注册后即可看到 API Key（免费）
# 限流：200 次/小时、20000 次/月；代码内置小时窗口（180/h）与 24h 缓存自我约束。
# 条款：使用其图片的页面必须展示指向 Pexels 的链接（前端在照片放大弹窗内渲染 PhotoCredit 署名）。
# 命中闸门：只有在 alt / 照片页 slug 里能匹配到地点名时才采用 —— 宁缺毋滥，不会拿通用风景图冒名。
PEXELS_API_KEY=
# Unsplash API 必须使用官方图片外链；仅保存选片元数据，不下载图片字节。
# 新行程采用已选图片也会上报 download_location；查看旧行程不搜索、不再上报。
# 申请：https://unsplash.com/developers；使用 Access Key（非 Secret Key）。
# 默认试用限额50/h，代码进程窗口45/h，每次生成最多12次请求（含选用上报）。
UNSPLASH_ACCESS_KEY=
# Pixabay：搜索结果（含空结果）缓存24h；入选图下载到本地，禁止永久热链。
# 申请：https://pixabay.com/api/docs/；代码进程窗口90/min，每次生成最多6次搜索。
PIXABAY_API_KEY=
# 后台景点视觉审核（与行程模型独立，需支持图片输入的Chat Completions端点）。
# 新生成及旧行程详情读取人工选图及新版审核图库；缺图优先入队，旧行程刷新补充展示。
PHOTO_REVIEW_ENABLED=true
PHOTO_REVIEW_BASE_URL=
PHOTO_REVIEW_API_KEY=
PHOTO_REVIEW_MODEL=
# 滚动24h最多处理的景点数，默认300，上限300；单景点最多18张候选。
# 额度只计首次启动的地点，重试不占额度、也不把窗口向后推移；额度耗尽时新地点排队等待并输出一次 [photo-review] 日志。
PHOTO_REVIEW_DAILY_PLACES=300
# 全站搜索调用日额度（超出自动降级，不阻断生成）
SEARCH_DAILY_BUDGET=500

# BYOK baseUrl 的 SSRF 私网豁免清单（逗号分隔的 host，例如站长自己的 Ollama）
# 例：SSRF_ALLOWLIST=localhost:11434,192.168.1.100:11434
SSRF_ALLOWLIST=
