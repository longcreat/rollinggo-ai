{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "paths": {
      "@rollinggo-trip/shared": ["../../packages/shared/src/index.ts"],
      "@rollinggo-trip/shared/*": ["../../packages/shared/src/*"],
      "@rollinggo-trip/core/*": ["../../packages/core/src/*"],
      "@rollinggo-trip/integrations/*": ["../../packages/integrations/src/*"],
      "@rollinggo-trip/services/*": ["../../packages/services/src/*"],
      "@rollinggo-trip/agent/*": ["../../packages/agent/src/*"],
      "@rollinggo-trip/evals/*": ["../../packages/evals/*"]
    }
  },
  "include": ["src", "test", "scripts"]
}
