{
  "name": "tripweaver",
  "version": "0.1.0",
  "private": true,
  "description": "织程 TripWeaver — 多 Agent 协作的开源智能旅行助手",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w apps/server\" \"npm run dev -w apps/web\"",
    "dev:doppler": "doppler run -- concurrently -n server,web -c blue,green \"npm run dev -w apps/server\" \"npm run dev -w apps/web\"",
    "secrets:sync": "doppler secrets download --no-file --format env > .env && cp .env apps/server/.env",
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p apps/server && tsc --noEmit -p apps/web && tsc --noEmit -p eval",
    "eval": "tsx --tsconfig eval/tsconfig.json eval/run.ts",
    "eval:live": "tsx --tsconfig eval/tsconfig.json eval/run.ts --live",
    "eval:diff": "tsx --tsconfig eval/tsconfig.json eval/diff.ts",
    "eval:accept": "tsx --tsconfig eval/tsconfig.json eval/accept.ts",
    "eval:test": "node --import tsx --test --test-concurrency=1 eval/tests/*.test.ts apps/server/src/__tests__/evalChecks.test.ts apps/server/src/__tests__/agentRuntime.test.ts apps/server/src/__tests__/agentHarnessTools.test.ts apps/server/src/__tests__/agentOverviewSync.test.ts apps/server/src/__tests__/agentSubagent.test.ts apps/server/src/__tests__/humanInLoop.test.ts apps/server/src/__tests__/healthCheck.test.ts apps/server/src/__tests__/mealEnrichment.test.ts apps/server/src/__tests__/llmCompat.test.ts apps/server/src/__tests__/placeNameMatch.test.ts apps/server/src/__tests__/draftValidate.test.ts apps/server/src/__tests__/poiTaskSource.test.ts apps/server/src/__tests__/projection.test.ts apps/server/src/__tests__/projectionChannel.test.ts apps/server/src/__tests__/projectionAdapter.test.ts apps/server/src/__tests__/generationTask.test.ts apps/server/src/__tests__/generationIdempotency.test.ts apps/server/src/__tests__/durablePhase.test.ts apps/server/src/__tests__/editClaim.test.ts apps/server/src/__tests__/generationStatus.test.ts apps/server/src/__tests__/planningPrompt.test.ts apps/server/src/__tests__/delegate.test.ts apps/server/src/__tests__/agentQuestions.test.ts apps/server/src/__tests__/completionMessage.test.ts apps/server/src/__tests__/dayTrim.test.ts",
    "eval:verify": "node eval/verify-live.mjs",
    "eval:agent": "tsx --tsconfig eval/tsconfig.json eval/agent/run.ts",
    "eval:agent:live": "tsx --tsconfig eval/tsconfig.json eval/agent/run.ts --live",
    "eval:flow": "tsx --tsconfig eval/tsconfig.json eval/flow.ts",
    "eval:campaign": "tsx --tsconfig eval/tsconfig.json eval/campaign.ts",
    "eval:campaign:report": "tsx --tsconfig eval/tsconfig.json eval/report-campaign.ts",
    "eval:campaign:review": "tsx --tsconfig eval/tsconfig.json eval/review-campaign.ts",
    "eval:campaign:audit": "tsx --tsconfig eval/tsconfig.json eval/audit-reviews.ts",
    "eval:knowledge:export": "tsx --tsconfig eval/tsconfig.json eval/export-knowledge.ts",
    "eval:knowledge:verify": "tsx --tsconfig eval/tsconfig.json eval/verify-knowledge.ts",
    "eval:retrieval": "node --import tsx scripts/retrieval-quality-baseline.mts",
    "assets:transparent": "node scripts/to-transparent.mjs",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/server"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3"
  }
}
