{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "paths": {
      "@rollinggo-trip/shared": ["../shared/src/index.ts"],
      "@rollinggo-trip/shared/*": ["../shared/src/*"],
      "@rollinggo-trip/core/*": ["../core/src/*"],
      "@rollinggo-trip/integrations/*": ["../integrations/src/*"],
      "@rollinggo-trip/services/*": ["../services/src/*"],
      "@rollinggo-trip/agent/*": ["../agent/src/*"]
    }
  },
  "include": ["."]
}
